{
  "version": "1.0",
  "project_id": "modelforecast",
  "description": "Tool-calling capability benchmarks for current OpenRouter LLM models.",
  "repository": "github.com/jw409/modelforecast",
  "stack": {
    "language": "python",
    "version": ">=3.11",
    "package_manager": "uv",
    "frameworks": [
      "openai-sdk",
      "rich",
      "httpx"
    ]
  },
  "excluded_infrastructure": {
    "gpu_services": true,
    "mcp_tools": true,
    "local_inference": true,
    "room_coordination": true,
    "local_gpu_ports": true
  },
  "execution_model": {
    "flow": "CLI -> SweepOrchestrator -> ProbeRunner -> OpenRouter API -> Results",
    "orchestration": "SweepOrchestrator with checkpoint-resume",
    "command_prefix": "uv run python"
  },
  "filesystem_sandbox": {
    "read": [
      "src/**",
      "tests/**",
      "games/**",
      "docs/**",
      "archive/**",
      "scripts/**"
    ],
    "write": [
      "var/**",
      "results/**",
      "charts/**",
      "src/**",
      "tests/**",
      "games/**",
      "scripts/**"
    ]
  },
  "tool_selection": {
    "default_path": "direct_python",
    "requires_file_ops": false,
    "requires_mcp": false,
    "requires_rooms": false,
    "requires_coordination": false,
    "decision_tree": {
      "run_sweep": "uv run python -m modelforecast sweep --confirm-spend",
      "validate_roster": "uv run python -m modelforecast sweep --validate-roster",
      "run_probe": "uv run python -m modelforecast --model <model> --probe <probe>",
      "run_tests": "uv run pytest tests/",
      "generate_results": "uv run python scripts/generate_readme_results.py"
    }
  },
  "api_dependencies": {
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "env_var": "OPENROUTER_API_KEY",
      "required": true,
      "default_roster": [
        "openai/gpt-5.6-sol",
        "anthropic/claude-opus-5",
        "deepseek/deepseek-v4-pro",
        "google/gemini-3.6-flash",
        "minimax/minimax-m3",
        "moonshotai/kimi-k3",
        "qwen/qwen3.7-max",
        "x-ai/grok-4.5",
        "z-ai/glm-5.2"
      ]
    }
  },
  "code_style": {
    "line_length": 100,
    "linter": "ruff",
    "lint_command": "uv run ruff check src/",
    "format_command": "uv run ruff format src/"
  },
  "context_boundaries": {
    "do_reference": [
      "CLAUDE.md",
      "README.md",
      "pyproject.toml",
      "src/modelforecast/"
    ],
    "do_not_reference": [
      "external project CLAUDE.md files",
      "external infrastructure"
    ]
  }
}
